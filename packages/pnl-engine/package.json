{
  "name": "@profitflow/pnl-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure realized-PnL engine (average cost + FIFO). Ported verbatim from the validated JS engine, typed for the monorepo.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/engine.test.ts",
    "validate": "tsx bin/validate.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
