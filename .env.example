# ─────────────────────────────────────────────────────────────────────────────
# ProfitFlow — root example env. Copy to `.env` and fill in. NEVER commit `.env`.
# Each app also has its own .env.example with app-specific notes.
# ─────────────────────────────────────────────────────────────────────────────

# Which data source the backend uses. The frontend never knows or cares which.
#   sim    — generated realistic fake events. No keys needed. Site looks alive immediately.
#   helius — real Solana ingest (needs HELIUS_API_KEY + a historical price source).
DATA_SOURCE=sim

# Public site origin — used for canonical URL, OG/twitter tags, and the share-card watermark.
# Domain is still TBD; profitflow.io is the placeholder. Change here only, nowhere in code.
NEXT_PUBLIC_SITE_URL=https://profitflow.io

# Where the browser reaches the API (REST + WebSocket). For local dev:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000/ws

# ── Infra (only needed once you move off `sim`) ──────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/profitflow
# REDIS_URL=redis://localhost:6379

# ── helius mode secrets (M3) ─────────────────────────────────────────────────
# HELIUS_API_KEY=
# Historical SOL→USD price source (per-timestamp). A flat price is the #1 error source.
# BIRDEYE_API_KEY=
# PYTH_PRICE_URL=https://hermes.pyth.network

# ── Distribution bot (M5) ────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
