# apps/api — REST + WebSocket feed
PORT=4000

# sim (default, no keys) | helius (reads the worker's emitted events from Redis + Postgres)
DATA_SOURCE=sim

# Comma-separated allowed origins for CORS, or * for any (dev default).
CORS_ORIGIN=*

# Only needed when DATA_SOURCE=helius. If unset, the live source degrades gracefully
# (serves an empty feed + logs) instead of crashing.
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://user:pass@localhost:5432/profitflow
