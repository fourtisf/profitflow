# apps/worker — ingest pipeline

# sim    -> dry-run: pipe simulated exits through the emit path (populates Postgres/Redis if set).
# helius -> real ingest from Helius (requires HELIUS_API_KEY + a historical price source).
DATA_SOURCE=sim

# ── helius mode ──────────────────────────────────────────────────────────────
# HELIUS_API_KEY=
# Webhook receiver port (point a Helius webhook here) + polling fallback interval.
WORKER_WEBHOOK_PORT=4100
POLL_INTERVAL_MS=15000
# Comma-separated wallet addresses to watch in polling mode (MVP). Webhooks scale past this.
# WATCH_ADDRESSES=

# Per-timestamp SOL->USD pricing. A FLAT price is the #1 error source — do not ship it.
# BIRDEYE_API_KEY=
# PYTH_PRICE_URL=https://hermes.pyth.network

# ── infra ────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/profitflow
# REDIS_URL=redis://localhost:6379
# REDIS_EXITS_CHANNEL=profitflow:exits

# Bounded universe liquidity floor (USD). Defaults to shared config ($50k).
# UNIVERSE_LIQUIDITY_FLOOR_USD=50000
