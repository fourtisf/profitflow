# apps/bot — hourly distribution bot

# Where to read exits from, and the site for card URLs + watermark.
API_URL=http://localhost:4000
SITE_URL=https://profitflow.io

# How often to post, and the minimum realized PnL worth posting.
BOT_INTERVAL_MS=3600000
BOT_MIN_PNL_USD=10000

# Telegram (fully wired). Without these the bot dry-runs (logs what it would post).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# X / Twitter (stub — needs OAuth 1.0a + media upload, see post.ts TODO).
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
