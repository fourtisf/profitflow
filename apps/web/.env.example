# apps/web — Next.js frontend (deploys to Vercel)

# Public site origin: canonical URL, OG/twitter tags, share-card watermark. Domain is TBD —
# this is the ONE place to change it. (profitflow.io is the current placeholder.)
NEXT_PUBLIC_SITE_URL=https://profitflow.io

# Where the browser reaches the API. If UNSET, the feed runs an in-browser simulation so the
# deployed site still looks alive (demo mode). Set these to go live against apps/api.
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_API_WS_URL=ws://localhost:4000/ws

# Waitlist persistence (optional). If unset, /api/waitlist logs the signup and returns ok.
# DATABASE_URL=postgresql://user:pass@localhost:5432/profitflow
